  "Basic": {
    "UserName": "nxai",
    "Password": "nxai"
  },
  "Mysql": {
    "ConnectionString": "Server=127.0.0.1;Port=3306;Database=nxai;User=root;Password=123456;CharSet=utf8mb4;",
    "ServerVersion": "8.0.36",
    "ServerType": "MySql"
  },
  "Mqtt": {
    "Enabled": true,
    "Host": "127.0.0.1",
    "Port": 1883,
    "ClientId": "nxai-device-svc",
    "Username": "nxai-device-svc",
    "Password": "nxai-device-svc"
  },
  "RabbitMq": {
    "HostName": "127.0.0.1",
    "Port": 5672,
    "VirtualHost": "/",
    "UserName": "guest",
    "Password": "guest"
  }
}
