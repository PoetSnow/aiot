{
  "CorsHosts": "*",
  "SwaggerUI": {
    "Enable": true,
    "RoutePrefix": "swagger"
  },
  "JWT": {
    "ValidateIssuer": true,
    "ValidIssuer": "nxai",
    "ValidateIssuerSigningKey": true,
    "SymmetricSecurityKey": "nxai-dev-symmetric-key-change-me-32b",
    "IssuerSigningKey": "nxai-dev-symmetric-key-change-me-32b",
    "ValidateAudience": true,
    "ValidAudience": "nxai",
    "RefreshTokenAudience": "nxai",
    "ValidateLifetime": true,
    "RequireExpirationTime": true,
    "ClockSkew": 30,
    "Expire": 120,
    "RefreshTokenExpire": 10080
